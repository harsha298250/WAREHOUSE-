# Smart Warehouse Intelligence Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to version control.
# See .gitignore — .env is excluded.
# ============================================================

# ---- Application Environment ----
# Set to "production" to enforce JWT secret validation and stricter security.
# Values: development | production
ENVIRONMENT=development




# ---- PostgreSQL Database ----
# Primary database connection string (required in production)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/postgres
# TARGET_DATABASE_URL is used optionally by database migration scripts
TARGET_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/postgres

# ---- Test Database (used by pytest — never the production DB) ----
# Leave as "sqlite" to use SQLite for tests (no MySQL server needed).
# Set to a MySQL DB name for full integration tests.
TEST_DB_NAME=sqlite

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-secure-random-secret-here

# Initial admin account password (used by init_db.py if no admin exists)
INITIAL_ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD_HERE

# Phase 18: Security & OTP Verification Settings
SECURITY_ALERT_EMAIL=security-alerts@yourcompany.com
LOGIN_OTP_REQUIRED=false
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=10
SECURITY_NOTIFICATION_RATE_LIMIT=20

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
# For production: https://your-domain.com
# For local dev: http://localhost:8000,http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- Google OAuth 2.0 / Sign-In ----
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Email Alerts (Required for OTP & security notifications) ----
# For Gmail: enable 2FA and create a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
SMTP_FROM_NAME=Warehouse OS



# ---- AWS S3 / Backblaze B2 / MinIO Cloud Storage (optional) ----
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-warehouse-backup-bucket
# Optional: Custom endpoint URL for Backblaze B2, Cloudflare R2, MinIO etc.
AWS_ENDPOINT_URL=

# ---- Upstash Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- CloudAMQP RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# ---- Celery Background Tasks ----
CELERY_ENABLED=false

# ---- Sentry Error Monitoring ----
SENTRY_DSN=https://your-sentry-key@o12345.ingest.sentry.io/12345

# ---- Resend Email Dispatch (Deprecated - NOT USED) ----
# RESEND_API_KEY=

# ---- Google Gemini API ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- ML Bypass Options (For troubleshooting/emergency only - NEVER production default) ----
BYPASS_FORECAST_CALCULATION=false
BYPASS_SHRINKAGE_CALCULATION=false



